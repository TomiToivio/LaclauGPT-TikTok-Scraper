{
  "name": "laclaugpt",
  "version": "1.0.0",
  "description": "Backend API for the legacy LaclauGPT TikTok Scraper",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "check:syntax": "node --check index.js",
    "lint": "eslint index.js ../Firefox/*.js",
    "lint:fix": "eslint index.js ../Firefox/*.js --fix",
    "format": "prettier --write index.js package.json ../Firefox/*.js ../Firefox/manifest.json ../README.md",
    "format:check": "prettier --check index.js package.json ../Firefox/*.js ../Firefox/manifest.json ../README.md",
    "webext:lint": "web-ext lint --source-dir ../Firefox",
    "check": "npm run check:syntax && npm run lint && npm run format:check && npm run webext:lint"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TomiToivio/LaclauGPT-TikTok-Scraper.git"
  },
  "keywords": [
    "TikTok",
    "web",
    "scraper",
    "data",
    "collection"
  ],
  "author": "Tomi Toivio",
  "license": "CC0-1.0",
  "bugs": {
    "url": "https://github.com/TomiToivio/LaclauGPT-TikTok-Scraper/issues"
  },
  "homepage": "https://github.com/TomiToivio/LaclauGPT-TikTok-Scraper#readme",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.0",
    "sqlite3": "^6.0.1"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.35.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "web-ext": "^10.7.0"
  }
}
